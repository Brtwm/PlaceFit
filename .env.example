# PlaceFit local/demo configuration.
# Copy to .env for local runs. Do not put real secrets in git.

# App
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Docker Compose Postgres service
POSTGRES_DB=placefit
POSTGRES_USER=placefit
POSTGRES_PASSWORD=placefit

# Backend database URLs
# For host/local uv runs, use localhost. docker-compose.yml overrides these
# inside containers to use the Compose service name: db.
DATABASE_URL=postgresql+psycopg://placefit:placefit@localhost:5432/placefit
TEST_DATABASE_URL=postgresql+psycopg://placefit:placefit@localhost:5432/placefit_test
ALLOW_DB_RESET_FOR_TESTS=false

# Streamlit -> FastAPI
# For Docker Compose this is overridden to http://backend:8000/api/v1.
PLACEFIT_API_BASE_URL=http://localhost:8000/api/v1

# Geodata providers
# fake/fake is the deterministic demo path and does not need API keys.
GEOCODER_PROVIDER=fake
POI_PROVIDER=fake
DGIS_API_KEY=
DGIS_BASE_URL=https://catalog.api.2gis.com
DGIS_TIMEOUT_SECONDS=5.0
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
OSM_TIMEOUT_SECONDS=10.0
EXTERNAL_USER_AGENT=PlaceFit/0.1 (+https://github.com/Brtwm/PlaceFit)

# Optional report LLM
# Fallback report works with LLM disabled and empty keys.
LLM_ENABLED=false
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
